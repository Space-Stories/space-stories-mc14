# Commanding Officer affiliation briefings for Kutjevo.

rmc-co-briefing-kutjevo-unaligned =
    { -rmc-co-briefing-logo }
    { "[bold]Кому:[/bold] [italic]Командующему офицеру ВКСШ Алмайер[/italic]" }
    { "[bold]От:[/bold] [bold]ПОЛКОВОЕ КОМАНДОВАНИЕ — СТАНЦИЯ ГСО «ЧИНУК-91»[/bold]" }
    { "[bold]Тема:[/bold] Оперативные задачи — район операции «Перерабатывающий завод Кутьево»" }
    { "[bold]Ссылка:[/bold] 48-77-AQ" }
    { "[bold]Гриф:[/bold] [color=#cb0000][bold]КОНФИДЕНЦИАЛЬНО[/bold][/color]" }
    { -rmc-co-briefing-divider }
    { "Командующий," }

    { "Вам приказано развернуться на перерабатывающем заводе Кутьево — принадлежащем Вестон-Ямаде комплексе очистки и розлива воды на пустынной планете Дикума I." }

    { "Связь с объектом полностью оборвалась 36 часов назад." }

    { "Завод жизненно важен для более чем двух тысяч жителей и является единственным предприятием региона, экспортирующим питьевую воду." }
    { -rmc-co-briefing-divider }
    { -rmc-co-briefing-primary }

    { "[bullet]Создать передовую оперативную базу возле водозаборного трубопровода и центрального узла очистки." }
    { "[bullet]Эвакуировать гражданских и работников завода, укрывающихся возле главного пульта управления резервуаром или фильтрационных камер." }
    { "[bullet]Обезопасить серверы данных завода и журналы поставок в центральной администрации." }

    { -rmc-co-briefing-secondary }

    { "[bullet]Восстановить системы жизнеобеспечения, чтобы предотвратить загрязнение водоносного слоя." }
    { "[bullet]Проверить технические шахты нижних уровней и водные тоннели на признаки активности ксеноформ." }
    { "[bullet]Не нарушать процессы фильтрации без тактической необходимости." }

    { "Из-за нарушения водоносного слоя местная фауна может проявлять агрессию." }
    { "[underline]Будьте осторожны в подземных зонах.[/underline]" }
    { -rmc-co-briefing-sign-unaligned }
    { -rmc-co-briefing-footer }

rmc-co-briefing-kutjevo-hawks =
    { -rmc-co-briefing-logo }
    { "[bold]Кому:[/bold] [italic]Командующему офицеру ВКСШ Алмайер[/italic]" }
    { "[bold]От:[/bold] [bold]ЦЕНТР ОБЕСПЕЧЕНИЯ БЕЗОПАСНОСТИ СЕКТОРА — ФОРТ «ГРОМ», ТРАППИСТ-5[/bold]" }
    { "[bold]Тема:[/bold] Протокол боевого контакта — район операции «Перерабатывающий завод Кутьево»" }
    { "[bold]Ссылка:[/bold] 48-77-SE" }
    { "[bold]Гриф:[/bold] [color=#cb0000][bold]КОНФИДЕНЦИАЛЬНО[/bold][/color]" }
    { -rmc-co-briefing-divider }
    { "Командующий," }

    { "Кутьево — не просто завод розлива. Это монополист водоносных слоёв Дикумы I." }

    { "Если биологическое загрязнение распространится по водной системе, оно может угрожать всей биосфере и вызвать масштабный экологический коллапс." }

    { "Ваша задача — быстро локализовать угрозу и перекрыть доступ к инфраструктуре." }
    { -rmc-co-briefing-divider }
    { -rmc-co-briefing-primary }

    { "[bullet]Укрепить передовую оперативную базу для защиты подходов к центральным фильтрационным шахтам." }
    { "[bullet]Уничтожить всю несанкционированную биологическую активность в водозаборных тоннелях и пещерах нижних уровней." }
    { "[bullet]Остановить либо взять под контроль все системы завода, чтобы предотвратить внешнее загрязнение или злоупотребление ими." }

    { -rmc-co-briefing-secondary }

    { "[bullet]Нейтрализовать враждебных выживших, пытающихся повредить или захватить транспортное оборудование Вестон-Ямады." }
    { "[bullet]Уничтожить животных с признаками необычных или неестественных мутаций возле водохранилища." }
    { "[bullet]Обрушить заражённые тоннельные системы при обнаружении крупных гнездовых структур возле глубоководных зон." }

    { "Это не имущество. Это путь для вторжения." }
    { "Перекройте его. Сожгите всё, что нельзя спасти." }
    { -rmc-co-briefing-sign-hawks }
    { -rmc-co-briefing-footer }

rmc-co-briefing-kutjevo-doves =
    { -rmc-co-briefing-logo }
    { "[bold]Кому:[/bold] [italic]Командующему офицеру ВКСШ Алмайер[/italic]" }
    { "[bold]От:[/bold] [bold]ПОЛЕВОЕ УПРАВЛЕНИЕ НАЧАЛЬНИКА ВОЕННОЙ ПОЛИЦИИ — КОЛОНИЯ «НЬЮ-МЕЙСОН», СИСТЕМА 61 ЛЕБЕДЯ[/bold]" }
    { "[bold]Тема:[/bold] Приоритеты развёртывания — район операции «Перерабатывающий завод Кутьево»" }
    { "[bold]Ссылка:[/bold] 48-77-HM" }
    { "[bold]Гриф:[/bold] [color=#cb0000][bold]КОНФИДЕНЦИАЛЬНО[/bold][/color]" }
    { -rmc-co-briefing-divider }
    { "Командующий," }

    { "Жители Кутьево зависят от водоносного слоя не только ради выживания, но и ради надежды." }

    { "Какая бы угроза ни постигла завод, наша операция должна быть сосредоточена на защите двух тысяч работников и сохранении природного равновесия этого хрупкого пустынного мира." }
    { -rmc-co-briefing-divider }
    { -rmc-co-briefing-primary }

    { "[bullet]Создать передовую оперативную базу возле ботанического блока и медицинского комплекса, не нарушая их работу." }
    { "[bullet]Найти и спасти невооружённых работников завода, укрывающихся в администрации или пунктах управления безопасностью." }
    { "[bullet]Защитить системы экологического контроля и подачи воды от намеренного либо случайного повреждения." }

    { -rmc-co-briefing-secondary }

    { "[bullet]По возможности применять нелетальные средства сдерживания при беспорядках или дезориентации работников." }
    { "[bullet]Не допустить утечки воды из водоносного слоя в повреждённые тоннели или неизвестные подземные пространства." }
    { "[bullet]Координировать эвакуацию через коридор к посадочной площадке Вестон-Ямады." }

    { "Помните: это их дом, их вода и их жизни." }
    { "Берегите эту землю и её жителей." }
    { -rmc-co-briefing-sign-doves }
    { -rmc-co-briefing-footer }

rmc-co-briefing-kutjevo-magpies =
    { -rmc-co-briefing-logo }
    { "[bold]Кому:[/bold] [italic]Командующему офицеру ВКСШ Алмайер[/italic]" }
    { "[bold]От:[/bold] [bold]УПРАВЛЕНИЕ ТЕХНИЧЕСКИХ ОПЕРАЦИЙ — СТАНЦИЯ «НАКОВАЛЬНЯ», ОРБИТА ГЕРКУЛИНЫ[/bold]" }
    { "[bold]Тема:[/bold] Исследовательские задачи — район операции «Перерабатывающий завод Кутьево»" }
