# Commanding Officer affiliation briefings for Hybrisa Prospera.

rmc-co-briefing-hybrisa-unaligned =
    { -rmc-co-briefing-logo }
    { "[bold]Кому:[/bold] [italic]Командующему офицеру ВКСШ Алмайер[/italic]" }
    { "[bold]От:[/bold] [bold]ПОЛКОВОЕ КОМАНДОВАНИЕ — СТАНЦИЯ ГСО «ЧИНУК-91»[/bold]" }
    { "[bold]Тема:[/bold] Оперативные задачи — район операции «Гибриса Проспера»" }
    { "[bold]Ссылка:[/bold] 48-77-AQ" }
    { "[bold]Гриф:[/bold] [color=#cb0000][bold]КОНФИДЕНЦИАЛЬНО[/bold][/color]" }
    { -rmc-co-briefing-divider }
    { "Командующий," }

    { "Ваша задача — отреагировать на полное прекращение связи с Гибрисой Просперой, крупной колонией на LV-759 с населением в десятки тысяч человек." }

    { "В колонии расположены критически важные предприятия по переработке минералов, крупный космопорт и ключевой транспортный узел Нероидского сектора." }

    { "После внезапной потери связи со всеми планетарными властями Империя Трёх Солнц и Вестон-Ямада совместно запросили вмешательство КМП США." }
    { -rmc-co-briefing-divider }
    { -rmc-co-briefing-primary }

    { "[bullet]Создать защищённую передовую оперативную базу возле центрального транспортного кольца и узла космопорта." }
    { "[bullet]Найти и эвакуировать ключевых государственных служащих, сотрудников безопасности и медиков из центра города и удалённого медицинского комплекса." }
    { "[bullet]Обезопасить засекреченные исследовательские данные Вестон-Ямады и не допустить их вывоза третьими лицами." }

    { -rmc-co-briefing-secondary }

    { "[bullet]Восстановить контроль над общегородскими системами энергоснабжения и движения через транспортные диспетчерские или инженерные узлы." }
    { "[bullet]Проверить слухи о погребённом сооружении пришельцев к югу от колонии. Провести разведку, но не углубляться внутрь без поддержки." }
    { "[bullet]Нейтрализовать или задержать военизированные силы в нижних районах города и корпоративных зонах." }

    { "Действуйте осторожно. Это населённый центр и очаг политической напряжённости." }
    { "По возможности сведите сопутствующий ущерб к минимуму." }
    { -rmc-co-briefing-sign-unaligned }
    { -rmc-co-briefing-footer }

rmc-co-briefing-hybrisa-hawks =
    { -rmc-co-briefing-logo }
    { "[bold]Кому:[/bold] [italic]Командующему офицеру ВКСШ Алмайер[/italic]" }
    { "[bold]От:[/bold] [bold]ЦЕНТР ОБЕСПЕЧЕНИЯ БЕЗОПАСНОСТИ СЕКТОРА — ФОРТ «ГРОМ», ТРАППИСТ-5[/bold]" }
    { "[bold]Тема:[/bold] Протокол боевого контакта — район операции «Гибриса Проспера»" }
    { "[bold]Ссылка:[/bold] 48-77-SE" }
    { "[bold]Гриф:[/bold] [color=#cb0000][bold]КОНФИДЕНЦИАЛЬНО[/bold][/color]" }
    { -rmc-co-briefing-divider }
    { "Командующий," }

    { "Гибриса Проспера была потеряна при подозрительных обстоятельствах сразу после вывода войск Империи Трёх Солнц." }

    { "Разведданные указывают, что контакт с противником мог совпасть с тайными операциями корпорации или быть ими ускорен. Теперь это враждебный городской район операции. Возьмите ситуацию под контроль до того, как Империя или любая другая сила успеет вмешаться." }
    { -rmc-co-briefing-divider }
    { -rmc-co-briefing-primary }

    { "[bullet]Укрепить передовую оперативную базу в месте с прямым доступом к густонаселённым гражданским районам и корпоративной инфраструктуре." }
    { "[bullet]Уничтожить предполагаемое заражение и опасные нечеловеческие формы в подземных транспортных тоннелях, канализационных сетях и местах раскопок возле камеры ксенокорабля." }
    { "[bullet]Захватить и заблокировать все тайные объекты Вестон-Ямады; персонал ЧВК задержать или ликвидировать." }

    { -rmc-co-briefing-secondary }

    { "[bullet]Не допустить вывоза через космопорт чувствительных технологий и биологического оружия контрабандистами с других миров." }
    { "[bullet]Установить контроль над каналом планетарной обороны Гибрисы и обезопасить складские бункеры Империи Трёх Солнц." }
    { "[bullet]Задержать или нейтрализовать известных агитаторов ФОК, действующих в рабочих районах." }

    { "Это больше не город. Это спорное поле боя." }
    { "Захватите его — быстро, жёстко и без колебаний." }
    { -rmc-co-briefing-sign-hawks }
    { -rmc-co-briefing-footer }

rmc-co-briefing-hybrisa-doves =
    { -rmc-co-briefing-logo }
    { "[bold]Кому:[/bold] [italic]Командующему офицеру ВКСШ Алмайер[/italic]" }
    { "[bold]От:[/bold] [bold]ПОЛЕВОЕ УПРАВЛЕНИЕ НАЧАЛЬНИКА ВОЕННОЙ ПОЛИЦИИ — КОЛОНИЯ «НЬЮ-МЕЙСОН», СИСТЕМА 61 ЛЕБЕДЯ[/bold]" }
    { "[bold]Тема:[/bold] Приоритеты развёртывания — район операции «Гибриса Проспера»" }
    { "[bold]Ссылка:[/bold] 48-77-HM" }
    { "[bold]Гриф:[/bold] [color=#cb0000][bold]КОНФИДЕНЦИАЛЬНО[/bold][/color]" }
    { -rmc-co-briefing-divider }
    { "Командующий," }

    { "Вы входите в одну из крупнейших городских колоний Нероидского сектора." }

    { "Некогда процветавший город, Гибриса всё сильнее страдала от нестабильности, завершившейся полным отключением планетарной инфраструктуры." }

    { "Мы должны рассматривать это одновременно как спасательную и миротворческую операцию." }
    { -rmc-co-briefing-divider }
    { -rmc-co-briefing-primary }

    { "[bullet]Развернуть передовую оперативную базу в месте с доступом к жилым районам и гражданским медицинским учреждениям." }
    { "[bullet]Найти и эвакуировать гражданских некомбатантов, уделяя особое внимание детям, раненым и медицинскому персоналу." }
    { "[bullet]Обезопасить и сохранить доступ к городскому центру управления экстренными службами." }

    { -rmc-co-briefing-secondary }

    { "[bullet]Не допускать повреждения больниц, убежищ и инфраструктуры связи." }
    { "[bullet]По возможности задерживать, а не убивать сотрудников ЧВК «Белая гвардия» и бойцов ФОК." }
    { "[bullet]Предложить безопасную сдачу всем оказавшимся в ловушке гражданским чиновникам и шахтёрам промышленных зон." }

    { "Под хаосом всё ещё могут скрываться живые люди." }
    { "Будьте их защитниками, а не захватчиками." }
    { -rmc-co-briefing-sign-doves }
    { -rmc-co-briefing-footer }

