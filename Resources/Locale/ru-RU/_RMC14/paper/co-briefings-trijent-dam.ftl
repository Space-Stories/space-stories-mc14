# Commanding Officer affiliation briefings for Trijent Dam.

rmc-co-briefing-trijent-unaligned =
    { -rmc-co-briefing-logo }
    { "[bold]Кому:[/bold] [italic]Командующему офицеру ВКСШ Алмайер[/italic]" }
    { "[bold]От:[/bold] [bold]ПОЛКОВОЕ КОМАНДОВАНИЕ — СТАНЦИЯ ГСО «ЧИНУК-91»[/bold]" }
    { "[bold]Тема:[/bold] Оперативные задачи — район операции «Дамба Триджент»" }
    { "[bold]Ссылка:[/bold] 48-77-AQ" }
    { "[bold]Гриф:[/bold] [color=#cb0000][bold]КОНФИДЕНЦИАЛЬНО[/bold][/color]" }
    { -rmc-co-briefing-divider }
    { "Командующий," }

    { "Вам приказано развернуться на дамбе Триджент — гидроэлектростанции, снабжающей энергией возвышенность Оксли и маршруты экспорта лития." }

    { "Колония потеряла связь после сейсмических аномалий и резкого падения выработки энергии." }

    { "Ожидайте враждебного сопротивления и неустойчивого рельефа." }
    { -rmc-co-briefing-divider }
    { -rmc-co-briefing-primary }

    { "[bullet]Создать и обезопасить передовую оперативную базу с удобным доступом к комплексу управления турбинами." }
    { "[bullet]Эвакуировать выживших техников и сотрудников безопасности из внутренних помещений дамбы и технического хранилища." }
    { "[bullet]Извлечь инженерные журналы и манифесты перевозки лития из оперативного терминала и экспортной площадки." }

    { -rmc-co-briefing-secondary }

    { "[bullet]Восстановить подачу энергии в нижние генераторные помещения для запуска систем очистки воды." }
    { "[bullet]Не допустить повреждения хранилища изотопов лития. Возможно вторичное заражение." }
    { "[bullet]Нейтрализовать противника на самой дамбе и центральном подъездном мосту." }

    { "Ожидайте высокой влажности, плохой видимости и возможного загрязнения воды." }
    { "Действуйте осторожно." }
    { -rmc-co-briefing-sign-unaligned }
    { -rmc-co-briefing-footer }

rmc-co-briefing-trijent-hawks =
    { -rmc-co-briefing-logo }
    { "[bold]Кому:[/bold] [italic]Командующему офицеру ВКСШ Алмайер[/italic]" }
    { "[bold]От:[/bold] [bold]ЦЕНТР ОБЕСПЕЧЕНИЯ БЕЗОПАСНОСТИ СЕКТОРА — ФОРТ «ГРОМ», ТРАППИСТ-5[/bold]" }
    { "[bold]Тема:[/bold] Протокол боевого контакта — район операции «Дамба Триджент»" }
    { "[bold]Ссылка:[/bold] 48-77-SE" }
    { "[bold]Гриф:[/bold] [color=#cb0000][bold]КОНФИДЕНЦИАЛЬНО[/bold][/color]" }
    { -rmc-co-briefing-divider }
    { "Командующий," }

    { "Вас высаживают в критически важной точке экономической инфраструктуры." }

    { "Дамба Триджент и порты перевалки лития питают производственную цепочку переработки трития." }

    { "Их потеря недопустима." }

    { "Ваша задача: вернуть, удержать, уничтожить." }
    { -rmc-co-briefing-divider }
    { -rmc-co-briefing-primary }

    { "[bullet]Развернуть передовую оперативную базу с контролем погрузочного отсека и телекоммуникаций." }
    { "[bullet]Очистить внутренние сооружения дамбы и хранилище лития от враждебных сил." }
    { "[bullet]Обезопасить все корпоративные запасы изотопов трития для стратегического перераспределения." }

    { -rmc-co-briefing-secondary }

    { "[bullet]Уничтожить посторонних, управляющих дамбой или похищающих ящики с литием." }
