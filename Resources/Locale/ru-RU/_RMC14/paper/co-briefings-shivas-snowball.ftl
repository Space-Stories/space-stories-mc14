# Commanding Officer affiliation briefings for Shiva's Snowball.

rmc-co-briefing-shivas-unaligned =
    { -rmc-co-briefing-logo }
    { "[bold]Кому:[/bold] [italic]Командующему офицеру ВКСШ Алмайер[/italic]" }
    { "[bold]От:[/bold] [bold]ПОЛКОВОЕ КОМАНДОВАНИЕ — СТАНЦИЯ ГСО «ЧИНУК-91»[/bold]" }
    { "[bold]Тема:[/bold] Оперативные задачи — район операции «Снежный шар Шивы»" }
    { "[bold]Ссылка:[/bold] 48-77-AQ" }
    { "[bold]Гриф:[/bold] [color=#cb0000][bold]КОНФИДЕНЦИАЛЬНО[/bold][/color]" }
    { -rmc-co-briefing-divider }
    { "Командующий," }

    { "Исследовательский аванпост Вестон-Ямады перестал выходить на связь 72 часа назад." }

    { "Объект расположен на незаселённом ледяном мире в дрейфе Альталуны и предназначен главным образом для геологических исследований и изучения климата при сверхнизких температурах." }

    { "Аванпост рассчитан на длительное проживание, оснащён полной системой жизнеобеспечения и оборудованием для глубинных раскопок." }

    { "[underline]Ожидается присутствие гражданских.[/underline]" }
    { -rmc-co-briefing-divider }
    { -rmc-co-briefing-primary }

    { "[bullet]Создать передовую оперативную базу возле главного входа в основной жилой блок." }
    { "[bullet]Найти и эвакуировать выживших сотрудников, особенно из общежития, медицинского отсека и общих зон отдыха." }
    { "[bullet]Обезопасить все журналы связи и резервные копии исследований в центре данных или серверной." }

    { -rmc-co-briefing-secondary }

    { "[bullet]По возможности восстановить энергоснабжение и климат-контроль объекта." }
    { "[bullet]Проверить нижние зоны раскопок на физические опасности и обрушения." }
    { "[bullet]Зарегистрировать аномалии среды и резкие падения температуры." }

    { "Приготовьтесь к плохой видимости, экстремальному холоду и разрушенной инфраструктуре." }
    { "Погодные условия и потеря отопления останутся постоянными угрозами." }
    { -rmc-co-briefing-sign-unaligned }
    { -rmc-co-briefing-footer }

rmc-co-briefing-shivas-hawks =
    { -rmc-co-briefing-logo }
    { "[bold]Кому:[/bold] [italic]Командующему офицеру ВКСШ Алмайер[/italic]" }
    { "[bold]От:[/bold] [bold]ЦЕНТР ОБЕСПЕЧЕНИЯ БЕЗОПАСНОСТИ СЕКТОРА — ФОРТ «ГРОМ», ТРАППИСТ-5[/bold]" }
    { "[bold]Тема:[/bold] Протокол боевого контакта — район операции «Снежный шар Шивы»" }
    { "[bold]Ссылка:[/bold] 48-77-SE" }
    { "[bold]Гриф:[/bold] [color=#cb0000][bold]КОНФИДЕНЦИАЛЬНО[/bold][/color]" }
    { -rmc-co-briefing-divider }
    { "Командующий," }

    { "Исследовательский объект Вестон-Ямады погас посреди одной из самых холодных и безжизненных планет дрейфа." }

    { "Характер исследований засекречен, но потеря всякой связи, включая связь с внутренней службой безопасности, требует немедленного внимания." }

    { "Вам разрешено проникнуть на объект и взять его под контроль силой." }
    { -rmc-co-briefing-divider }
    { -rmc-co-briefing-primary }

    { "[bullet]Создать укреплённую передовую оперативную базу с открытыми секторами обстрела в направлении раскопок." }
    { "[bullet]Уничтожить угрозы и восстановить контроль над наземными и подземными сооружениями." }
    { "[bullet]Захватить исследовательские хранилища, оружейные и силовые узлы до совершения диверсии или стирания данных." }

    { -rmc-co-briefing-secondary }

    { "[bullet]Уничтожить полевые лаборатории Вестон-Ямады, которые невозможно взять под контроль." }
    { "[bullet]Отслеживать переносчиков биологической угрозы и сообщения о заражении." }
    { "[bullet]Не позволять выжившим покидать объект без полного опроса и досмотра." }

    { "[underline]Не доверяйте никому на объекте.[/underline]" }
    { "Если корпорация называла это «метеостанцией», скорее всего, это лаборатория." }
    { -rmc-co-briefing-sign-hawks }
    { -rmc-co-briefing-footer }

rmc-co-briefing-shivas-doves =
    { -rmc-co-briefing-logo }
    { "[bold]Кому:[/bold] [italic]Командующему офицеру ВКСШ Алмайер[/italic]" }
    { "[bold]От:[/bold] [bold]ПОЛЕВОЕ УПРАВЛЕНИЕ НАЧАЛЬНИКА ВОЕННОЙ ПОЛИЦИИ — КОЛОНИЯ «НЬЮ-МЕЙСОН», СИСТЕМА 61 ЛЕБЕДЯ[/bold]" }
    { "[bold]Тема:[/bold] Приоритеты развёртывания — район операции «Снежный шар Шивы»" }
    { "[bold]Ссылка:[/bold] 48-77-HM" }
    { "[bold]Гриф:[/bold] [color=#cb0000][bold]КОНФИДЕНЦИАЛЬНО[/bold][/color]" }
    { -rmc-co-briefing-divider }
    { "Командующий," }

    { "«Шива-1» — небольшая исследовательская станция Вестон-Ямады на замёрзшем изолированном мире." }

    { "Она была автономной и до недавнего времени совершенно мирной." }

    { "Её внезапное молчание вызывает опасения по поводу отказа оборудования, чрезвычайной медицинской ситуации или экологической катастрофы." }

    { "[underline]Вас направляют не как оккупантов, а как следователей.[/underline]" }
    { -rmc-co-briefing-divider }
    { -rmc-co-briefing-primary }

    { "[bullet]Развернуть на объекте передовую оперативную базу, не повредив входные тоннели и жилые купола." }
    { "[bullet]Найти и эвакуировать всех выживших учёных, инженеров и техников." }
    { "[bullet]Защитить исследовательские архивы от повреждения погодой и уничтожения корпорацией." }

    { -rmc-co-briefing-secondary }

    { "[bullet]Восстановить отопление и подачу кислорода в жилых помещениях." }
    { "[bullet]Применять к безоружным людям нелетальные методы. Отдавать приоритет дипломатии." }
    { "[bullet]Сканировать подозрительные зоны раскопок и докладывать о них, не разрушая объекты." }

    { "У каждого учёного там, внизу, были семья, призвание и жизнь, которую стоит спасти." }
    { "Не забывайте об этом." }
    { -rmc-co-briefing-sign-doves }
    { -rmc-co-briefing-footer }

