    .desc = { ent-CMFirstAidKit.desc }
ent-CMFirstAidKitFilled = { ent-CMFirstAidKit }
    .desc = Это аптечка неотложной помощи с базовыми лекарствами и оборудованием. Для использования не нужна подготовка. С медицинской подготовкой её можно уложить в рюкзак.
    .suffix = Заполненный
