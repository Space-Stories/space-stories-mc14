    .suffix = { ent-RMCPVECaseFlamerFuel.suffix }
ent-RMCPVECaseL104Fuel = кейс топливных баков инсинератора L104
    .desc = Тяжёлый кейс с шестью топливными баками для инсинератора L104.
    .suffix = { ent-RMCBasePVEEquipmentCase.suffix }
ent-RMCPVECaseMotionDetector = кейс для детекторов движения
    .desc = Кейс, содержащий четыре индивидуальных портативных детектора движения.
    .suffix = { ent-RMCBasePVEEquipmentCase.suffix }
