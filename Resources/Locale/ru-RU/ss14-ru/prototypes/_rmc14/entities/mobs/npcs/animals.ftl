    .suffix = { ent-RMCMobCatCalico.suffix }
ent-RMCMobGarry = Гэрри
    .desc = Ее мех выглядит и ощущается как бархат, а хвост периодически дрожит.
    .suffix = { ent-RMCMobCat.suffix }
ent-RMCMobBernard = Бернард
    .desc = Также известен как Берни. Любит растения в горшках и лакомства со вкусом космического карпа.
    .suffix = { ent-RMCMobCat.suffix }
ent-RMCMobButtons = Пуговка
