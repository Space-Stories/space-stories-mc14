ent-RMCAutodoc = аварийная медицинская система "Автодок"
    .desc = Аварийное хирургическое устройство, которое автоматически проводит спасающее жизнь лечение и простые операции без участия хирурга.
    .suffix = С консолью
ent-RMCAutodocNoConsole = { ent-RMCAutodoc }
    .desc = { ent-RMCAutodoc.desc }
    .suffix = Без консоли
ent-RMCAutodocConsole = консоль управления автодоком
    .desc = Интерфейс управления для подключённого автодока. Для правильной работы нужна подготовка.
ent-RMCAutodocUnskilled = продвинутая аварийная медицинская система "Автодок"
    .desc = Гораздо более дорогая модель автодока с диагностическим модулем ИИ. В итоге интерфейс намного проще — нажми и готово, — и пользоваться им может кто угодно, независимо от подготовки.
    .suffix = Без навыка, Улучшенный
ent-RMCAutodocConsoleUpgraded = улучшенная консоль управления автодоком
    .desc = { ent-RMCAutodocConsole.desc }
