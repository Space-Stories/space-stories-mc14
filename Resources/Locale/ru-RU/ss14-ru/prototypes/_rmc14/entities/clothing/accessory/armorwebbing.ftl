ent-RMCArmorWebbingBase = бронеразгрузка
    .desc = { ent-BaseItem.desc }
    .suffix = PVE
ent-RMCArmorWebbingDrum = бронеразгрузка для барабанных магазинов
    .desc = Коричневая разгрузочная система, оснащенная парой больших подсумков, способных вмещать барабанные магазины большой емкости и другие крупные магазины.
    .suffix = { ent-RMCArmorWebbingBase.suffix }
ent-RMCArmorWebbingMag = бронеразгрузка для магазинов
    .desc = Коричневая разгрузочная система, оснащенная парой больших подсумков, способных вмещать магазины.
    .suffix = { ent-RMCArmorWebbingBase.suffix }
ent-RMCArmorWebbingGrenade = бронеразгрузка для гранат
    .desc = Коричневая разгрузочная система с несколькими небольшими карманами, предназначенными для переноски 6 гранат.
    .suffix = { ent-RMCArmorWebbingBase.suffix }
ent-RMCArmorWebbingPouch = бронеразгрузка
    .desc = Коричневая разгрузочная система с несколькими небольшими карманами, предназначенными для переноски различных мелких предметов.
    .suffix = { ent-RMCArmorWebbingBase.suffix }
ent-RMCArmorWebbingShell = бронеразгрузка для дроби
    .desc = Коричневая разгрузочная система с несколькими петлями, предназначенными для удержания незакрепленных патронов для дробовика.
    .suffix = { ent-RMCArmorWebbingBase.suffix }
ent-RMCArmorWebbingDrumRCM = бронеразгрузка MOLS для барабанных магазинов
    .desc = Комплект разгрузки MOLS образца L1, доработанный для крепления на модульный бронежилет L3 "Сокол". Оснащена парой больших подсумков для барабанных и других крупных магазинов.
    .suffix = PVE, Королевский
ent-RMCArmorWebbingMagRCM = бронеразгрузка MOLS для магазинов
    .desc = Комплект разгрузки MOLS образца L1, доработанный для крепления на модульный бронежилет L3 "Сокол". Оснащена четырьмя подсумками для магазинов.
    .suffix = PVE, Королевский
ent-RMCArmorWebbingGrenadeRCM = бронеразгрузка MOLS для гранат
    .desc = Комплект разгрузки MOLS образца L1, доработанный для крепления на модульный бронежилет L3 "Сокол". Оснащена рядом небольших подсумков, вмещающих до 6 гранат.
    .suffix = PVE, Королевский
ent-RMCArmorWebbingPouchRCM = универсальная бронеразгрузка MOLS
    .desc = Комплект разгрузки MOLS образца L1, доработанный для крепления на модульный бронежилет L3 "Сокол". Оснащена несколькими небольшими подсумками для разных мелочей.
    .suffix = PVE, Королевский
ent-RMCArmorWebbingShellRCM = бронеразгрузка MOLS для патронов
    .desc = Комплект разгрузки MOLS образца L1, доработанный для крепления на модульный бронежилет L3 "Сокол". Оснащена петлями для россыпи патронов к дробовику.
    .suffix = PVE, Королевский
