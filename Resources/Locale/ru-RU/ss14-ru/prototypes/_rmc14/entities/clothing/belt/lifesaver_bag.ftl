ent-CMBeltMedicBag = пояс M276 медицинский
    .desc = Пояс M276 медицинский является стандартным снаряжением КМП США. В этой конфигурации на нем крепится вещевой мешок, наполненный различными инъекторами и легкими медицинскими принадлежностями, и широко распространенный среди медиков.
ent-RMCBeltMedicBagERTFilled = { ent-CMBeltMedicBag }
    .desc = { ent-CMBeltMedicBag.desc }
ent-RMCBeltMedicBagSPP = спасательная сумка образца Тип 41
    .desc = Разгрузка Тип 41 — стандартное разгрузочное снаряжение вооружённых сил СПН. В этой конфигурации на неё крепится вещмешок с набором инъекторов и лёгких медицинских припасов. Распространена среди медиков.
ent-RMCBeltMedicBagSPPCommandoFilled = { ent-RMCBeltMedicBagSPP }
    .desc = { ent-RMCBeltMedicBagSPP.desc }
    .suffix = Коммандо, Заполненный
ent-RMCBeltMedicBagSPPCrashland = { ent-RMCBeltMedicBagSPP }
    .desc = { ent-RMCBeltMedicBagSPP.desc }
    .suffix = Выживший, Заполненный
ent-RMCBeltMedicBagSPPSynthFilled = { ent-RMCBeltMedicBagSPP }
    .desc = { ent-RMCBeltMedicBagSPP.desc }
    .suffix = Синтетик, Заполненный
ent-RMCBeltMedicBagPMC = медицинская сумка образца WY-TM625
    .desc = WY-TM625 — стандартное грузовое снаряжение сил безопасности W-Y. В этой конфигурации на ней крепится вещевой мешок, наполненный различными инъекторами и легкими медицинскими принадлежностями, и она широко распространена среди медиков.
ent-RMCBeltMedicBagPMCFilled = { ent-RMCBeltMedicBagPMC }
    .desc = { ent-RMCBeltMedicBagPMC.desc }
    .suffix = Заполненный
ent-RMCBeltMedicBagNV = пояс 276-B медицинский
    .desc = M276-B — нестандартный вариант медицинского пояса M276, используемого КМП. Вариант «B» имеет пониженую общую вместимость благодаря переработке формы и улучшенные материалы, предотвращающие повреждение содержимого сумки при движении через густую растительность.
ent-RMCBeltMedicBagNVFilledPartial = { ent-RMCBeltMedicBagNV }
    .desc = { ent-RMCBeltMedicBagNV.desc }
    .suffix = Заполненный, Частично
ent-RMCBeltMedicBagRoyal = { ent-CMBeltMedicBag }
    .suffix = Заполненный, Королевский
    .desc = { ent-CMBeltMedicBag.desc }
