st-hivemanagement-banish = Banish (500)
st-hivemanagement-readmit = Re-Admit

st-banish-title = Banishment
st-banish-choose = Choose a xenomorph to banish
st-banish-confirm = Are you sure you want to banish {$target} from the hive? This should only be done with good reason. They will not be able to rejoin the hive for 30 minutes after dying unless readmitted.
st-banish-reason = Provide a reason for banishing {$target}. This will be announced to the entire hive!
st-banish-need-reason = You must provide a reason for banishing {$target}.
st-banish-self = You cannot banish yourself.
st-banish-already = {CAPITALIZE($target)} is already banished!
st-banish-other-hive = {CAPITALIZE($target)} doesn't belong to your hive!
st-banish-incapacitated = What's the point? {CAPITALIZE($target)} is already about to die.
st-banish-announce = By {$queen}'s will, {$target} has been banished from the hive!

    {$reason}
st-banish-target = {CAPITALIZE($queen)} has banished you from the hive! Other xenomorphs may now attack you freely, but you cannot harm your former sisters. The weeds at the heart of the hive reject you, and you no longer heal. Leave a host on the hive's weeds, and if your sisters nest it, the Queen can readmit you for free.
st-banish-hive-name = Banished {$target}
st-banish-death = Hive: {$xeno} has died at {$location}! They were banished from the hive.
st-banish-banned-from-hive = You are banished from this hive, you may not rejoin unless the Queen re-admits you or dies.
st-banish-action-blocked = We are banished and cannot reach the hivemind.

st-readmit-title = Readmittance
st-readmit-choose = Choose a xenomorph to readmit
st-readmit-confirm = Are you sure you want to readmit {$target} into the hive? Cost: {$cost} plasma.
st-readmit-target = {CAPITALIZE($queen)} has readmitted you into the hive.
st-readmit-done = {$target} has been readmitted into the hive.
st-readmit-announce = By {$queen}'s will, {$target} has been readmitted into the hive!

st-banish-tunnel-denied = We are banished and the tunnels no longer accept us.
st-readmit-option = {$name} (hosts: {$deliveries}, plasma: {$cost})
st-banish-delivery-left = Banished {$xeno} has left the host {$host} at {$location}!
st-banish-delivery-accepted = The hive has accepted a host from banished {$xeno}. Total hosts: {$count}.
st-banish-delivery-accepted-target = The hive has accepted your host. Total hosts: {$count}. The Queen can readmit you for free.
