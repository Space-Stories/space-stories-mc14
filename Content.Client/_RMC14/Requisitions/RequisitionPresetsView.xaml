<controls:RequisitionPresetsView xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Requisitions"
    xmlns:ui="clr-namespace:Content.Client.UserInterface.Controls"
    Orientation="Vertical" Margin="8" HorizontalExpand="True" VerticalExpand="True">
    <RichTextLabel Text="{Loc rmc-requisitions-presets-help}" Margin="0 0 0 6" HorizontalExpand="True" />
    <BoxContainer Orientation="Horizontal" SeparationOverride="6" Margin="0 0 0 6">
        <Button Name="ImportClipboard" Access="Public" Text="{Loc rmc-requisitions-presets-import}"
                ToolTip="{Loc rmc-requisitions-presets-import-tooltip}" HorizontalExpand="True" />
        <Button Name="ExportClipboard" Access="Public" Text="{Loc rmc-requisitions-presets-export}"
                ToolTip="{Loc rmc-requisitions-presets-export-tooltip}" HorizontalExpand="True" />
    </BoxContainer>
    <OptionButton Name="Selection" Access="Public" HorizontalExpand="True" />
    <BoxContainer Orientation="Horizontal" Margin="0 6 0 6" SeparationOverride="6">
        <LineEdit Name="PresetName" Access="Public" HorizontalExpand="True"
                  PlaceHolder="{Loc rmc-requisitions-presets-name}" />
        <Button Name="Rename" Access="Public" Text="{Loc rmc-requisitions-presets-rename}" />
    </BoxContainer>
    <Label Text="{Loc rmc-requisitions-presets-composition}" StyleClasses="LabelKeyText" />
    <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
        <RichTextLabel Name="Preview" Access="Public" HorizontalExpand="True" />
    </ScrollContainer>
    <RichTextLabel Name="Status" Access="Public" Margin="0 6 0 6" />
    <BoxContainer Name="ImportActions" Access="Public" Visible="False"
                  Orientation="Horizontal" SeparationOverride="6">
        <Button Name="ConfirmImport" Access="Public" Text="{Loc rmc-requisitions-presets-confirm-import}"
                HorizontalExpand="True" />
        <Button Name="CancelImport" Access="Public" Text="{Loc rmc-requisitions-presets-cancel-import}" />
    </BoxContainer>
    <BoxContainer Name="LoadActions" Access="Public" Orientation="Horizontal" SeparationOverride="6">
        <Button Name="Load" Access="Public" Text="{Loc rmc-requisitions-presets-load}"
                HorizontalExpand="True" />
        <ui:ConfirmButton Name="ReplaceCart" Access="Public" Visible="False"
                          Text="{Loc rmc-requisitions-presets-load}"
                          ConfirmationText="{Loc rmc-requisitions-presets-replace-confirm}"
                          HorizontalExpand="True" />
        <ui:ConfirmButton Name="Delete" Access="Public" Text="{Loc rmc-requisitions-presets-delete}"
                          ConfirmationText="{Loc rmc-requisitions-presets-delete-confirm}" />
    </BoxContainer>
    <BoxContainer Name="SaveActions" Access="Public" Orientation="Horizontal" Margin="0 6 0 0" SeparationOverride="6">
        <Button Name="SaveNew" Access="Public" Text="{Loc rmc-requisitions-presets-save-new}"
                HorizontalExpand="True" />
        <ui:ConfirmButton Name="Update" Access="Public" Text="{Loc rmc-requisitions-presets-update}"
                          ConfirmationText="{Loc rmc-requisitions-presets-update-confirm}"
                          HorizontalExpand="True" />
    </BoxContainer>
</controls:RequisitionPresetsView>
