<controls:RequisitionsWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Requisitions"
    xmlns:uiControls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc rmc-requisitions-window-title}"
    SetSize="900 600"
    MinSize="780 560">
    <BoxContainer Orientation="Horizontal" Margin="10" HorizontalExpand="True" VerticalExpand="True">
        <PanelContainer Name="CategoryPanel"
                        Access="Public"
                        MinWidth="180"
                        VerticalExpand="True">
            <BoxContainer Orientation="Vertical"
                          HorizontalExpand="True"
                          VerticalExpand="True">
                <Button Name="PlatformButton"
                        Access="Public"
                        Text="{Loc rmc-requisitions-platform-raise}"
                        StyleClasses="ButtonSquare"
                        HorizontalExpand="True" />
                <Control MinHeight="8" />
                <RichTextLabel Name="BudgetLabel" Access="Public" />
                <RichTextLabel Name="CapacityLabel" Access="Public" />
                <Control MinHeight="8" />
                <Label Text="{Loc rmc-requisitions-categories-title}" StyleClasses="LabelKeyText" />
                <Control MinHeight="4" />
                <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                    <BoxContainer Name="CategoriesContainer"
                                  Access="Public"
                                  Orientation="Vertical"
                                  HorizontalExpand="True" />
                </ScrollContainer>
            </BoxContainer>
        </PanelContainer>
        <Control MinWidth="14" />
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <LineEdit Name="SearchBar"
                      Access="Public"
                      PlaceHolder="{Loc rmc-requisitions-search-placeholder}"
                      HorizontalExpand="True" />
            <Control MinHeight="8" />
            <TabContainer Name="ShopTabs"
                          Access="Public"
                          HorizontalExpand="True"
                          VerticalExpand="True">
                <BoxContainer Name="ProductsTab"
                              Access="Public"
                              Orientation="Vertical"
                              Margin="8 8 8 8"
                              HorizontalExpand="True"
                              VerticalExpand="True">
                    <ScrollContainer Name="ProductsScroll" Access="Public" HorizontalExpand="True"
                                     VerticalExpand="True"
                                     HScrollEnabled="False">
                        <BoxContainer Name="ProductsContainer"
                                      Access="Public"
                                      Orientation="Vertical"
                                      HorizontalExpand="True" />
                    </ScrollContainer>
                    <BoxContainer Name="ProductPages" Access="Public" Orientation="Horizontal"
                                  HorizontalAlignment="Center" Margin="0 6 0 0" SeparationOverride="6">
                        <Button Name="PreviousProductPage" Access="Public" Text="‹"
                                ToolTip="{Loc rmc-requisitions-page-previous}" MinWidth="32" />
                        <Label Text="{Loc rmc-requisitions-page}" />
                        <SpinBox Name="ProductPageNumber" Access="Public" MinWidth="55" MaxWidth="70" />
                        <Label Name="ProductPageCount" Access="Public" />
                        <Button Name="NextProductPage" Access="Public" Text="›"
                                ToolTip="{Loc rmc-requisitions-page-next}" MinWidth="32" />
                    </BoxContainer>
                </BoxContainer>
                <BoxContainer Name="CartTab"
                              Access="Public"
                              Orientation="Vertical"
                              Margin="8 8 8 8"
                              HorizontalExpand="True"
                              VerticalExpand="True">
                    <ScrollContainer HorizontalExpand="True"
                                     VerticalExpand="True"
                                     HScrollEnabled="False"
                                     MinHeight="220">
                        <BoxContainer Name="CartContainer"
                                      Access="Public"
                                      Orientation="Vertical"
                                      HorizontalExpand="True" />
                    </ScrollContainer>
                    <RichTextLabel Name="CartStatusLabel" Access="Public" />
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2">
                            <RichTextLabel Name="CartTotalLabel" Access="Public" HorizontalExpand="True" />
                            <Label Name="CartShipping" Access="Public" Visible="False" MouseFilter="Stop" />
                        </BoxContainer>
                        <Button Name="ClearCartButton"
                                Access="Public"
                                Text="{Loc rmc-requisitions-cart-clear}"
                                StyleClasses="ButtonSquare"
                                MinWidth="120" />
                        <Control MinWidth="5" />
                        <uiControls:ConfirmButton Name="BuyButton"
                                                  Access="Public"
                                                  Text="{Loc rmc-requisitions-buy}"
                                                  ConfirmationText="{Loc rmc-requisitions-buy-confirm}"
                                                  StyleClasses="ButtonSquare"
                                                  MinWidth="120" />
                    </BoxContainer>
                </BoxContainer>
                <controls:RequisitionPresetsView Name="PresetsTab" Access="Public" Visible="False" />
                <BoxContainer Name="RequestsTab"
                              Access="Public"
                              Orientation="Vertical"
                              Margin="8"
                              HorizontalExpand="True"
                              VerticalExpand="True">
                    <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                        <BoxContainer Name="RequestsContainer" Access="Public"
                                      Orientation="Vertical" HorizontalExpand="True" />
                    </ScrollContainer>
                    <RichTextLabel Name="RequestsStatus" Access="Public" />
                </BoxContainer>
                <BoxContainer Name="PendingTab"
                              Access="Public"
                              Orientation="Vertical"
                              Margin="8 8 8 8"
                              HorizontalExpand="True"
                              VerticalExpand="True">
                    <ScrollContainer HorizontalExpand="True"
                                     VerticalExpand="True"
                                     HScrollEnabled="False">
                        <BoxContainer Name="PendingContainer"
                                      Access="Public"
                                      Orientation="Vertical"
                                      HorizontalExpand="True" />
                    </ScrollContainer>
                    <RichTextLabel Name="PendingStatusLabel" Access="Public" />
                </BoxContainer>
            </TabContainer>
            <BoxContainer Name="RequestReasonPanel" Access="Public" Orientation="Vertical"
                          Visible="False" Margin="0 6 0 0">
                <Label Text="{Loc rmc-requisitions-request-reason}" />
                <LineEdit Name="RequestReason" Access="Public"
                          PlaceHolder="{Loc rmc-requisitions-request-reason-placeholder}" />
            </BoxContainer>
            <RichTextLabel Name="RequestFeedback" Access="Public" Margin="0 4 0 0" />
        </BoxContainer>
    </BoxContainer>
</controls:RequisitionsWindow>
