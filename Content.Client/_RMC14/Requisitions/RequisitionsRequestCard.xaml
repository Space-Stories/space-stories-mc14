<controls:RequisitionsRequestCard xmlns="https://spacestation14.io"
                                xmlns:controls="clr-namespace:Content.Client._RMC14.Requisitions"
                                xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                                xmlns:ui="clr-namespace:Content.Client.UserInterface.Controls"
                                Orientation="Vertical" HorizontalExpand="True" Margin="0 0 0 8">
    <PanelContainer HorizontalExpand="True">
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="#24252f" BorderColor="#5e6f91" BorderThickness="2" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="4" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="10">
                <Label Name="Title" Access="Public" StyleClasses="LabelKeyText" HorizontalExpand="True" />
                <Button Name="Eject" Access="Public" Text="{Loc rmc-requisitions-eject-form}"
                        Visible="False" />
            </BoxContainer>
            <RichTextLabel Name="Requester" Access="Public" HorizontalExpand="True" />
            <RichTextLabel Name="Reason" Access="Public" HorizontalExpand="True" />
            <RichTextLabel Name="Cost" Access="Public" HorizontalExpand="True" />
            <BoxContainer Name="Lines" Access="Public" Orientation="Vertical" HorizontalExpand="True"
                          SeparationOverride="8" Margin="0 4" />
            <PanelContainer HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#303344" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="6">
                    <RichTextLabel Name="Plan" Access="Public" HorizontalExpand="True" />
                </BoxContainer>
            </PanelContainer>
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:ConfirmButton Name="Approve" Access="Public" Text="{Loc rmc-requisitions-request-approve}"
                                  ConfirmationText="{Loc rmc-requisitions-request-approve-confirm}"
                                  StyleClasses="ButtonSquare" />
                <ui:ConfirmButton Name="Deny" Access="Public" Text="{Loc rmc-requisitions-request-deny}"
                                  ConfirmationText="{Loc rmc-requisitions-request-deny-confirm}"
                                  StyleClasses="ButtonSquare" Margin="5 0 0 0" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:RequisitionsRequestCard>
