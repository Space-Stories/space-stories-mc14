<controls:RequisitionsRequestLine xmlns="https://spacestation14.io"
                                 xmlns:controls="clr-namespace:Content.Client._RMC14.Requisitions"
                                 xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                                 Orientation="Vertical" HorizontalExpand="True">
    <PanelContainer HorizontalExpand="True">
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="#2e303a" BorderColor="#4a4d5c" BorderThickness="1" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="6" SeparationOverride="3">
            <RichTextLabel Name="Title" Access="Public" HorizontalExpand="True" />
            <RichTextLabel Name="Progress" Access="Public" HorizontalExpand="True" />
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 2" SeparationOverride="4">
                <Label Text="{Loc rmc-requisitions-process-quantity}"
                       ToolTip="{Loc rmc-requisitions-process-quantity-tooltip}" />
                <Button Name="Remove" Access="Public" Text="-" StyleClasses="ButtonSquare"
                        MinWidth="30" Margin="6 0 0 0" />
                <SpinBox Name="Quantity" Access="Public" MinWidth="50" MaxWidth="65" />
                <Button Name="Add" Access="Public" Text="+" StyleClasses="ButtonSquare" MinWidth="30" />
                <Control MinWidth="8" />
                <CheckBox Name="Purchase" Access="Public" Text="{Loc rmc-requisitions-purchase-missing}"
                          ToolTip="{Loc rmc-requisitions-purchase-missing-tooltip}" Pressed="True" />
            </BoxContainer>
            <RichTextLabel Name="Preview" Access="Public" HorizontalExpand="True" />
            <RichTextLabel Name="PurchasePreview" Access="Public" HorizontalExpand="True" />
        </BoxContainer>
    </PanelContainer>
</controls:RequisitionsRequestLine>
