<local:TacticalMapContextPopup
    xmlns="https://spacestation14.io"
    xmlns:local="clr-namespace:Content.Client._RMC14.TacticalMap.UI"
    xmlns:controls="clr-namespace:Content.Client._RMC14.TacticalMap.Controls"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client">
    <PanelContainer Name="Background">
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" Margin="2 2 2 2">
            <BoxContainer Orientation="Horizontal" SeparationOverride="3">
                <TextureRect Name="AreaIcon" MinSize="18 18" MaxSize="18 18" Stretch="KeepAspectCentered" />
                <Label Name="AreaNameLabel" StyleClasses="LabelSmall" FontColorOverride="White" ClipText="True" MaxWidth="400" />
            </BoxContainer>
            <BoxContainer Orientation="Vertical" Margin="0 2 0 2">
                <Label Name="CoordinatesLabel" StyleClasses="LabelSmall" FontColorOverride="#E5E5E5" />
                <Label Name="AreaIdLabel" StyleClasses="LabelSmall" FontColorOverride="#E5E5E5" />
                <Label Name="LinkedLzLabel" StyleClasses="LabelSmall" FontColorOverride="#E5E5E5" />
                <Label Name="TacticalLabel" StyleClasses="LabelSmall" FontColorOverride="#8AB4FF" ClipText="True" MaxWidth="400" />
                <Label Name="RegionLabel" StyleClasses="LabelSmall" FontColorOverride="#E5E5E5" ClipText="True" MaxWidth="400" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="10" Margin="0 2 0 0">
                    <BoxContainer Name="AllowedActions" Orientation="Vertical" SeparationOverride="1">
                        <Label Text="{Loc rmc-tactical-map-context-allowed-title}" StyleClasses="LabelSmall" FontColorOverride="#43B581" />
                        <Label Name="AllowedLabel" StyleClasses="LabelSmall" FontColorOverride="#43B581" />
                    </BoxContainer>
                    <BoxContainer Name="BlockedActions" Orientation="Vertical" SeparationOverride="1">
                        <Label Text="{Loc rmc-tactical-map-context-blocked-title}" StyleClasses="LabelSmall" FontColorOverride="#ED4245" />
                        <Label Name="BlockedLabel" StyleClasses="LabelSmall" FontColorOverride="#ED4245" />
                    </BoxContainer>
                    <BoxContainer Name="ButtonColumn" Orientation="Vertical" SeparationOverride="4" Margin="6 0 0 0">
                        <controls:TacticalMapButton Name="CreateLabelButton" MinHeight="20" HorizontalExpand="True" />
                        <controls:TacticalMapButton Name="CreateMortarButton" MinHeight="20" HorizontalExpand="True" />
                        <controls:TacticalMapButton Name="DeleteMortarButton" MinHeight="20" HorizontalExpand="True" />
                        <controls:TacticalMapButton Name="CopyCoordinatesButton" MinHeight="20" HorizontalExpand="True" />
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</local:TacticalMapContextPopup>
