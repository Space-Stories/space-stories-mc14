<controls:RMCConstructionWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Construction"
    Title="Construction"
    SetSize="460 540"
    MinSize="380 360">
    <BoxContainer Orientation="Vertical" Margin="4">
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 6">
            <Button Name="BackButton" Access="Public" Text="← Back" Visible="False" Margin="0 0 8 0" />
            <TextureRect Name="MaterialIcon" Access="Public" SetSize="24 24" Stretch="KeepAspectCentered" VerticalAlignment="Center" Margin="0 0 6 0" />
            <Label Name="MaterialLabel" Access="Public" HorizontalExpand="True" VerticalAlignment="Center" />
        </BoxContainer>
        <LineEdit Name="SearchEdit" Access="Public" PlaceHolder="Search..." Margin="0 0 0 6" />
        <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="ConstructionContainer" Access="Public" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2" />
        </ScrollContainer>
    </BoxContainer>
</controls:RMCConstructionWindow>
